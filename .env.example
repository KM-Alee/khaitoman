# Copy to .env (setup.sh does this). Never commit .env.
# Copilot (F19, built last in M7). Model must be confirmed on your account in M0 (T11.8).
OPENAI_API_KEY=
AABFLOW_OPENAI_MODEL=gpt-6.1-sol

# Optional overrides
# AABFLOW_DATA_DIR=./data
# AABFLOW_DB_PATH=./data/app.sqlite

# Optional: Esri World Imagery as the sub-metre, display-only map basemap (docs/IMAGERY.md).
# ArcGIS Location Platform API key with only the Basemaps privilege. Empty = Sentinel-2 only.
# VITE_ARCGIS_KEY=
